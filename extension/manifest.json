{
  "manifest_version": 3,
  "name": "Browser Caption Extension",
  "description": "Extract subtitles from the current Bilibili or YouTube video page.",
  "version": "0.4.0",
  "permissions": ["activeTab", "scripting", "downloads", "storage", "unlimitedStorage", "declarativeNetRequestWithHostAccess", "offscreen"],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://api.bilibili.com/*",
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://*.googlevideo.com/*",
    "https://api.groq.com/*",
    "https://aisubtitle.hdslb.com/*",
    "https://*.hdslb.com/*",
    "https://*.bilivideo.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "audio_cdn_headers",
        "enabled": true,
        "path": "rules/audio_cdn_headers.json"
      }
    ]
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "offscreen_documents": [
    {
      "matches": ["https://www.youtube.com/*", "https://www.bilibili.com/*"],
      "reasons": ["AUDIO_PLAYBACK"],
      "justification": "Decode long audio to 16kHz mono WAV slices for Groq transcription."
    }
  ],
  "action": {
    "default_title": "Extract captions",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/video/*",
        "https://www.youtube.com/watch*",
        "https://www.youtube.com/shorts/*",
        "https://m.youtube.com/watch*",
        "https://m.youtube.com/shorts/*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected/bilibili-page.js", "injected/youtube-page.js"],
      "matches": [
        "https://www.bilibili.com/*",
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ]
    },
    {
      "resources": ["offscreen/offscreen.html", "offscreen/offscreen.js"],
      "matches": ["https://www.youtube.com/*", "https://www.bilibili.com/*"]
    }
  ]
}
